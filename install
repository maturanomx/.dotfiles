#!/usr/bin/env bash

set -euo pipefail

log() {
	printf "\n>>> %s\n" "$*"
}

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

IS_WSL=false
OS="$(uname)"
if [[ "${OS}" == "Linux" ]]; then
	grep -qi "microsoft\|wsl" /proc/sys/kernel/osrelease 2>/dev/null && IS_WSL=true
	# shellcheck disable=SC1091
	source /etc/os-release
	OS="${ID_LIKE:-${ID}}"
fi

# Same values zsh/zshenv exports on login shells; duplicated here because this script runs before the zshenv symlink
# exists (mise creates it in the apply below)
export MISE_CONFIG_DIR="${SCRIPT_DIR}"
[[ "${OS}" == "Darwin" ]] && export MISE_ENV=macos
[[ "${OS}" == *debian* || "${OS}" == *ubuntu* ]] && export MISE_ENV=managed

case "${OS}" in
*arch*)
	# -------------------------------
	# Paru for Arch 󰣇 - https://github.com/Morganamilo/paru
	# -------------------------------
	log "Installing packages via paru..."
	if ! command -v paru &>/dev/null; then
		sudo pacman -S --noconfirm --needed base-devel git

		PARU_DIR=$(mktemp -d)
		git clone https://aur.archlinux.org/paru.git "${PARU_DIR}"
		(cd "${PARU_DIR}" && makepkg -si --noconfirm)
		rm -rf "${PARU_DIR}"
	fi

	paru -Syu --noconfirm
	# shellcheck disable=SC2046 # word splitting is intentional: one arg per package
	paru -S --noconfirm --needed \
		$(awk '/^# desktop/{exit} /^[a-zA-Z0-9]/{print}' "${SCRIPT_DIR}/packages.arch")

	# shellcheck disable=SC2046 # word splitting is intentional: one arg per package
	[[ "${IS_WSL}" == "true" ]] ||
		paru -S --noconfirm --needed \
			$(awk 'f && /^[a-zA-Z0-9]/{print} /^# desktop/{f=1}' "${SCRIPT_DIR}/packages.arch")

	# npm globals default to /usr/lib/node_modules (root-owned). Changed to a user-owned location
	npm config set prefix "${HOME}/.local/share/npm"
	;;

Darwin)
	# -------------------------------
	# Homebrew for MacOS 󰀵 - https://brew.sh/
	# -------------------------------
	log "Installing packages via Homebrew..."
	export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"
	if ! command -v brew &>/dev/null; then
		sudo -v
		NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	fi
	eval "$(brew shellenv)"

	brew bundle --file="${SCRIPT_DIR}/packages.brew"
	;;

*debian* | *ubuntu*)
	# -------------------------------
	#  APT for Debian 󰣚 / Ubuntu 󰕈 -
	# -------------------------------
	log "Installing packages via apt + mise..."
	sudo apt update -y
	sudo apt install -y curl git

	# mise apt repo - https://mise.jdx.dev/installing-mise.html
	sudo install -dm 755 /etc/apt/keyrings
	curl -fSs https://mise.jdx.dev/gpg-key.pub | sudo tee /etc/apt/keyrings/mise-archive-keyring.asc 1>/dev/null
	echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.asc] https://mise.jdx.dev/deb stable main" |
		sudo tee /etc/apt/sources.list.d/mise.list
	sudo apt update -y

	# shellcheck disable=SC2046 # word splitting is intentional: one arg per package
	sudo apt install -y \
		$(grep '^[a-zA-Z0-9]' "${SCRIPT_DIR}/packages.debian")

	# apt versions are too old. Install CLI tools declared in config.managed.toml
	eval "$(mise activate bash --shims)"
	mise install

	# CLI tools without apt packages
	npm install -g @anthropic-ai/claude-code opencode-ai
	;;

*)
	echo "Unsupported OS/distribution: ${OS}" >&2
	exit 1
	;;
esac

mkdir -p "${HOME}/.config"
install -dm 700 "${HOME}/.private"

# Write the local vars file templates render from; unattended runs (no tty)
# skip this and the epilogue prints instructions instead
if [[ ! -f "${SCRIPT_DIR}/config.local.toml" && -t 0 ]]; then
	log "Configuring identity..."
	read -rp "Enter your name: " IDENTITY_NAME
	read -rp "Enter your email: " IDENTITY_EMAIL
	cat <<_vars >"${SCRIPT_DIR}/config.local.toml"
[vars]
name = "${IDENTITY_NAME}"
email = "${IDENTITY_EMAIL}"
_vars
fi

log "Applying dotfiles..."
# --force replaces pre-existing files (OS defaults); day-2 runs use plain apply so drift surfaces
mise bootstrap dotfiles apply --force --yes

log "Configuring SSH..."
SSH_TYPE="ed25519"
SSH_FILENAME="${HOME}/.ssh/id_${SSH_TYPE}"
SSH_KEY_CREATED=false
install -dm 700 "${HOME}/.ssh"
if [[ ! -f "${SSH_FILENAME}" ]]; then
	ssh-keygen -t "${SSH_TYPE}" -N "" -f "${SSH_FILENAME}" -C "$(hostname)"
	SSH_KEY_CREATED=true
fi

log "Configuring git..."
# Ensure dotfiles dir is a git repo with SSH remote (handles both clone and ZIP download cases)
GIT_NEEDS_SYNC=false
if ! git -C "${SCRIPT_DIR}" rev-parse --git-dir &>/dev/null; then
	git -C "${SCRIPT_DIR}" init
	git -C "${SCRIPT_DIR}" remote add origin git@github.com:maturanomx/.dotfiles.git
	GIT_NEEDS_SYNC=true
else
	git -C "${SCRIPT_DIR}" remote set-url origin git@github.com:maturanomx/.dotfiles.git
fi

log "Configuring zsh..."
[[ "$SHELL" == */zsh ]] || chsh -s "$(command -v zsh)"

log "Installing zimfw..."
# zimfw - https://zimfw.sh
ZIM_HOME="${HOME}/.zim"
[[ -f "${ZIM_HOME}/zimfw.zsh" ]] || curl -fsSL --create-dirs \
	-o "${ZIM_HOME}/zimfw.zsh" \
	https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh

if [[ "${OS}" == "Darwin" ]]; then
	# altgr-intl layout (as in Linux). Keyboard layouts don't load from symlinks, so copy
	KEYLAYOUT="/Library/Keyboard Layouts/us-altgr-intl.keylayout"
	if ! cmp -s "${SCRIPT_DIR}/_assets/us-altgr-intl.keylayout" "${KEYLAYOUT}"; then
		sudo install -m 644 "${SCRIPT_DIR}/_assets/us-altgr-intl.keylayout" "${KEYLAYOUT}"
		printf ">>> Keyboard layout installed. After logging out and back in, add it via:\n"
		printf "    System Settings > Keyboard > Input Sources > Edit > + > Others > us-altgr-intl\n"
	fi
fi

command -v bat &>/dev/null && bat cache --build

if [[ "${OS}" != "Darwin" ]]; then
	log "Enabling system services..."
	sudo systemctl enable --now sshd
	sudo systemctl enable --now docker
	sudo usermod -aG docker "${USER}"
fi

cat <<'_done'

>>> Setup complete!
>>> It is recommended to log out and back in for all changes to take effect:
>>>   - Default shell (zsh)
>>>   - Docker group membership (Linux)
>>>   - PATH and environment from ~/.zshenv / ~/.zshrc
_done

if [[ "${SSH_KEY_CREATED}" == "true" ]]; then
	printf "\n>>> ACTION REQUIRED: Add your new SSH key to GitHub before continuing.\n"
	printf "    https://github.com/settings/ssh/new\n\n"
	cat "${SSH_FILENAME}.pub"
fi

if [[ ! -f "${SCRIPT_DIR}/config.local.toml" ]]; then
	printf "\n>>> ACTION REQUIRED: Create %s/config.local.toml ([vars] name/email — template in ~/.private/gitconfig)\n" "${SCRIPT_DIR}"
	printf "    then run: mise bootstrap dotfiles apply\n"
fi

if [[ "${GIT_NEEDS_SYNC}" == "true" ]]; then
	printf "\n>>> ACTION REQUIRED: Sync dotfiles git history after adding the SSH key:\n\n"
	printf "    git -C %s fetch origin\n" "${SCRIPT_DIR}"
	printf "    git -C %s symbolic-ref HEAD refs/heads/main\n" "${SCRIPT_DIR}"
	printf "    git -C %s reset --hard origin/main\n\n" "${SCRIPT_DIR}"
fi

# cp thisIsFine_animated.mp4 Library/Containers/com.microsoft.teams2/Data/Library/Application\ Support/Microsoft/MSTeams/Backgrounds/feelingDreamy4Animated_v=0.1.mp4
